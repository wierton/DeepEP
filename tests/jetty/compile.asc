// Instantiate the actual production kernels with installed CANN headers.
#define EP_PP_SEND
#define EP_PP_RECV
#include <deep_ep/impls/pp/pp_send_recv.hpp>
#include <deep_ep/impls/bucket/all_gather/urma.hpp>
#include <deep_ep/impls/ep/dispatch.hpp>
#include <deep_ep/impls/ep/combine.hpp>
#include <deep_ep/impls/ep/dispatch_copy_epilogue.hpp>
#include <deep_ep/impls/ep/combine_reduce_epilogue.hpp>
#include <deep_ep/impls/comm/barrier.hpp>

__attribute__((used)) static void instantiate() {
    auto send = &deep_ep::pp_send_impl<1000000000>;
    auto recv = &deep_ep::pp_recv_impl<1000000000>;
    auto bucket = &deep_ep::urma_all_gather_impl<8, 1000000000>;
    auto dispatch = &deep_ep::dispatch_impl<8, 256, 6, 128, false, false,
        64, 7168, 56, 16384, 196608, 1000000000, true>;
    auto cached_dispatch = &deep_ep::dispatch_impl<8, 256, 6, 128, true, false,
        64, 7168, 56, 16384, 196608, 1000000000, true>;
    auto combine = &deep_ep::combine_impl<8, 6, 7168, 16384, 64, 1000000000, 196608, true, true>;
    auto combine_no_weights = &deep_ep::combine_impl<8, 6, 7168, 16384, 64, 1000000000, 196608, true, false>;
    auto simd_barrier = &deep_ep::barrier_impl<8, 64, 64, 1000000000, false>;
    auto simt_barrier = &deep_ep::barrier_impl<8, 64, 64, 1000000000, true>;
    auto dispatch_epilogue = &deep_ep::dispatch_copy_epilogue_impl<
        8, 256, 6, 128, false, true, 64, 7168, 56, 16384, 196608, 1000000000>;
    auto combine_epilogue = &deep_ep::combine_reduce_epilogue_impl<
        8, 256, 6, 7168, 16384, 196608, 64, 1000000000>;
    auto single_rank_combine = &deep_ep::combine_impl<
        1, 6, 7168, 16384, 64, 1000000000, 196608, true, true>;
    auto fewer_ranks_than_topk = &deep_ep::combine_impl<
        4, 6, 7168, 16384, 64, 1000000000, 196608, true, true>;
}
