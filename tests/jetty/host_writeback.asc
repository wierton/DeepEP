// Isolate mapped-host writeback from all HCCL/Jetty communication.
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"

struct View {
    __gm__ uint32_t& value;
};

__simt_vf__ __aicore__ __launch_bounds__(32)
void Probe(View view, __gm__ uint32_t* direct, __gm__ uint64_t* observed, int write) {
    if (threadIdx.x == 0) {
        observed[0] = reinterpret_cast<uint64_t>(&view.value);
        observed[1] = reinterpret_cast<uint64_t>(direct);
        if (write) view.value = 123;
    }
}

__global__ __aicore__ __vector__
void ProbeKernel(__gm__ uint32_t* mapped, __gm__ uint64_t* observed, int write) {
    AscendC::Simt::VF_CALL<Probe>(AscendC::Simt::Dim3(32), View{*mapped}, mapped, observed, write == 1 || write == 3);
    if (write == 2) {
        *mapped = 123;
        AscendC::GlobalTensor<uint32_t> tensor;
        tensor.SetGlobalBuffer(mapped, 1);
        AscendC::DataCacheCleanAndInvalid<uint32_t, AscendC::CacheLine::SINGLE_CACHE_LINE,
            AscendC::DcciDst::CACHELINE_OUT>(tensor);
    }
}

#define CHECK(call) do { auto error = (call); if (error) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, int(error)); return 1; } } while (0)

int main(int argc, char** argv) {
    const int write = argc > 1 ? std::atoi(argv[1]) : 0;
    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));
    void* host = nullptr;
    void* mapped = nullptr;
    void* observed = nullptr;
    if (write == 3) {
        host = std::aligned_alloc(4096, 4096);
        if (!host) return 1;
        CHECK(aclrtHostRegisterV2(host, 4096, ACL_HOST_REG_PINNED | ACL_HOST_REG_MAPPED));
        CHECK(aclrtHostGetDevicePointer(host, &mapped, 0));
    } else {
        CHECK(aclrtMallocHost(&host, 4096));
        CHECK(aclrtHostRegister(host, 4096, ACL_HOST_REGISTER_MAPPED, &mapped));
    }
    CHECK(aclrtMalloc(&observed, 64, ACL_MEM_MALLOC_NORMAL_ONLY));
    *static_cast<uint32_t*>(host) = 0;
    std::printf("host=%p mapped=%p write=%d\n", host, mapped, write);
    std::fflush(stdout);
    ProbeKernel<<<1, 0, stream>>>(static_cast<uint32_t*>(mapped), static_cast<uint64_t*>(observed), write);
    CHECK(aclrtSynchronizeStream(stream));
    uint64_t addresses[2]{};
    CHECK(aclrtMemcpy(addresses, sizeof(addresses), observed, sizeof(addresses), ACL_MEMCPY_DEVICE_TO_HOST));
    std::printf("view=%#lx direct=%#lx value=%u\n", addresses[0], addresses[1], *static_cast<uint32_t*>(host));
    const bool valid = addresses[0] == reinterpret_cast<uint64_t>(mapped) &&
                       addresses[1] == reinterpret_cast<uint64_t>(mapped) &&
                       (!write || *static_cast<uint32_t*>(host) == 123);
    CHECK(aclrtFree(observed));
    CHECK(aclrtHostUnregister(host));
    if (write == 3) std::free(host);
    else CHECK(aclrtFreeHost(host));
    CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0));
    CHECK(aclFinalize());
    return valid ? 0 : 2;
}
